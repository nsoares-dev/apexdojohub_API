    "/API/Usuario/CriarUsuario": {
      "post": {
        "tags": [
          "Usuario"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "Nome"
                ],
                "type": "object",
                "properties": {
                  "Nome": {
                    "type": "string"
                  },
                  "Login": {
                    "type": "string"
                  },
                  "Email": {
                    "type": "string",
                    "format": "email"
                  },
                  "Senha": {
                    "minLength": 7,
                    "pattern": "^(?=.*[A-Za-z])(?=.*\\d)(?=.*[^A-Za-z0-9]).+$",
                    "type": "string"
                  },
                  "TipoUsuario": {
                    "$ref": "#/components/schemas/TipoUsuario"
                  },
                  "FotoPerfil": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "Nome": {
                  "style": "form"
                },
                "Login": {
                  "style": "form"
                },
                "Email": {
                  "style": "form"
                },
                "Senha": {
                  "style": "form"
                },
                "TipoUsuario": {
                  "style": "form"
                },
                "FotoPerfil": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
